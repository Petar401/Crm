# Supabase — get these from your project's API settings (https://app.supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of the deployed app, used to build auth redirect links
# (e.g. the password-reset callback). Must match a Supabase Redirect URL.
# Leave blank locally to default to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Server-only. NEVER expose to the browser. Used for privileged server operations.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Groq API key for AI actions (get one free at https://console.groq.com).
# Acts as the default/fallback key; workspaces can override it from Settings.
# Leave blank to require every workspace to set its own key.
GROQ_API_KEY=

# Server-only. Encrypts per-workspace secrets stored in the database — AI API
# keys, the Apollo.io key, AND the connected business-email mailbox password
# (Settings > Email account). Required if workspaces will connect a mailbox or
# set their own key from Settings. Generate with: openssl rand -hex 32
AI_KEY_ENCRYPTION_SECRET=

# Server-only. Shared secret protecting the scheduled lead-discovery route
# (/api/cron/leads). Generate a random string and use the same value in the
# Supabase pg_cron job (see supabase/migrations/0011_lead_automation.sql).
CRON_SECRET=

# --- Email integration (phase 2 / OAuth — not required for IMAP/SMTP) ---
# The current mailbox connection uses IMAP/SMTP with an app password entered in
# Settings and needs no env vars beyond AI_KEY_ENCRYPTION_SECRET above. These
# are reserved for the upcoming "Sign in with Google/Microsoft" OAuth option.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
